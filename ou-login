#!/usr/bin/env bash

# Description: Log in to an OpenUnison host with kubectl openunison-cli and rename
# the resulting context, cluster and user. Hosts and their kubeconfig files live in
# ~/.config/openunison-config.yaml

OU_LOGIN_VERSION="0.1.2"

if [ -t 1 ]; then
  red=$(tput setaf 1)
  gold=$(tput setaf 3)
  cyan=$(tput setaf 6)
  default=$(tput sgr0)
fi

conf="${OU_LOGIN_CONFIG:-$HOME/.config/openunison-config.yaml}"

usage() {
  cat <<EOF
Usage: ou-login [hostname]
       ou-login add

Log in to an OpenUnison host. With no hostname, pick one with fzf.
"add" prompts for a new host and appends it to the config.

Options:
  -h, --help     Show this help
  -v, --version  Show the version

Config: ${conf} (override with OU_LOGIN_CONFIG)

  hosts:
    - hostname: k8sou.example.com
      kubeconfig: ~/.kube/config-playground
      context: playground   # optional; renames context, cluster and user
EOF
}

die() {
  echo "${red}$*${default}" >&2
  exit 1
}

check_version() {
  command -v curl >/dev/null 2>&1 || return 0
  local latest
  latest=$(curl -s --max-time 5 "https://api.github.com/repos/peledies/ou-login/releases/latest" 2>/dev/null |
    yq -p json '.tag_name // ""' 2>/dev/null)
  latest="${latest#v}"
  if [ -n "$latest" ] && [ "$latest" != "$OU_LOGIN_VERSION" ]; then
    echo "${gold}Update available: v${latest} (current: v${OU_LOGIN_VERSION})${default}" >&2
    echo "${gold}Run: brew update && brew upgrade ou-login${default}" >&2
  fi
}

create_config() {
  mkdir -p "$(dirname "$conf")" && echo "hosts: []" > "$conf" || die "Could not write ${conf}"
  echo "${cyan}Created ${conf}${default}"
}

add_host() {
  local h k c def
  read -r -p "OpenUnison hostname: " h
  [ -n "$h" ] || die "A hostname is required."
  if [ -f "$conf" ] && [ -n "$(H="$h" yq '.hosts[] | select(.hostname == strenv(H)) | .hostname' "$conf")" ]; then
    die "'${h}' is already in ${conf}."
  fi
  read -r -p "Context name (optional): " c
  def="~/.kube/config${c:+-$c}"
  read -r -p "Kubeconfig file [${def}]: " k
  k="${k:-$def}"

  [ -f "$conf" ] || create_config
  H="$h" K="$k" C="$c" yq -i '
    .hosts += [{"hostname": strenv(H), "kubeconfig": strenv(K), "context": strenv(C)}] |
    del(.hosts[] | select(.context == "") | .context)
  ' "$conf" || die "Could not update ${conf}"
  echo "${cyan}Added ${h} to ${conf}${default}"
}

rename_context() {
  # Rename the context, cluster and user the login wrote (e.g. user@playground,
  # playground, user@playground) to $ctx. On a re-login the old $ctx entries are
  # replaced by the fresh ones.
  src=$(N="$ctx" yq '.contexts[].name | select(. != strenv(N))' "$cfg")
  if [ "$(printf '%s\n' "$src" | grep -c .)" -gt 1 ]; then
    echo "${red}More than one other context in ${cfg}; not renaming:${default}" >&2
    printf '%s\n' "$src" >&2
    return 1
  fi
  [ -z "$src" ] && src="$ctx"

  cl=$(S="$src" yq '.contexts[] | select(.name == strenv(S)) | .context.cluster' "$cfg")
  us=$(S="$src" yq '.contexts[] | select(.name == strenv(S)) | .context.user' "$cfg")

  N="$ctx" S="$src" C="$cl" U="$us" yq -i '
    del(.contexts[] | select(.name == strenv(N) and .name != strenv(S))) |
    del(.clusters[] | select(.name == strenv(N) and .name != strenv(C))) |
    del(.users[]    | select(.name == strenv(N) and .name != strenv(U))) |
    (.contexts[] | select(.name == strenv(S)) | .name) = strenv(N) |
    (.contexts[] | select(.name == strenv(N)) | .context.cluster) = strenv(N) |
    (.contexts[] | select(.name == strenv(N)) | .context.user) = strenv(N) |
    (.clusters[] | select(.name == strenv(C)) | .name) = strenv(N) |
    (.users[]    | select(.name == strenv(U)) | .name) = strenv(N) |
    .current-context = strenv(N)
  ' "$cfg" || return 1
  echo "${cyan}Context, cluster and user: ${ctx}${default}"
}

case "$1" in
  -h|--help) usage; exit 0 ;;
  -v|--version) echo "ou-login ${OU_LOGIN_VERSION}"; exit 0 ;;
  -*) usage >&2; exit 1 ;;
esac

command -v yq >/dev/null 2>&1 || die "Required command not found: yq"

if [ "$1" = "add" ]; then
  add_host
  exit 0
fi

command -v kubectl >/dev/null 2>&1 || die "Required command not found: kubectl"

check_version

host="$1"

if [ ! -f "$conf" ]; then
  [ -t 0 ] || die "Config not found: ${conf}"
  read -r -p "Config not found: ${conf}. Create it? [y/N] " reply
  [[ "$reply" =~ ^[Yy] ]] || exit 1
  create_config
  echo "${cyan}Run 'ou-login add' to add a host.${default}"
  exit 0
fi

if [ -z "$host" ]; then
  command -v fzf >/dev/null 2>&1 || die "No hostname given and fzf is not installed."
  host=$(yq '.hosts[].hostname' "$conf" | fzf --height 40% --layout reverse --header "OpenUnison login") || exit 1
fi

cfg=$(H="$host" yq '.hosts[] | select(.hostname == strenv(H)) | .kubeconfig // ""' "$conf")
ctx=$(H="$host" yq '.hosts[] | select(.hostname == strenv(H)) | .context // ""' "$conf")
cfg="${cfg/#\~/$HOME}"

[ -n "$cfg" ] || die "Unknown host '${host}'. Add it to ${conf}."

echo "${cyan}Logging in to ${host}${default}"
echo "${cyan}Using kubeconfig: ${cfg}${default}"
KUBECONFIG="$cfg" kubectl openunison-cli login "$host" || exit 1

if [ -n "$ctx" ]; then
  rename_context || exit 1
else
  ctx=$(yq '.current-context // ""' "$cfg")
fi

# Switch the context in the user's own kubectl setup (KUBECONFIG may merge
# several files, and the first file's current-context wins).
[ -n "$ctx" ] || exit 0
if kubectl config get-contexts -o name 2>/dev/null | grep -qxF "$ctx"; then
  kubectl config use-context "$ctx" >/dev/null || exit 1
  echo "${cyan}Current context: ${ctx}${default}"
else
  echo "${gold}${cfg} is not in your KUBECONFIG, so '${ctx}' is only current in that file.${default}" >&2
  echo "${gold}Run: export KUBECONFIG=\"\${KUBECONFIG:-\$HOME/.kube/config}:${cfg}\"${default}" >&2
fi
